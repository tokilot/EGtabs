# Settings of the server. Copy this file to .env.local (kept out of git) and fill in what you need; a line left
# commented out keeps its default. A variable set in the system's environment wins over the same one here.
# The TABS_AI_* settings are read again for every request; the others need the server restarted.

# Ports: `npm run dev` (page and API together), `npm start` and the desktop pet (the built page and the API), and the
# API on its own (`npm start -w server`).
# TABS_DEV_PORT=7273
# TABS_APP_PORT=7273
# TABS_PORT=7274

# Paths: write them in full (the server does not run from the repository's top folder).

# The data folder (user.db, song folders, sample sets, models). Default: data/ in the repository.
# TABS_DATA_DIR=E:/Music/tabs-data

# The assistant (the pet in the bottom-left corner): any OpenAI-compatible chat completions service.
# "/chat/completions" is added to the base URL. No key for a local service such as Ollama.
TABS_AI_BASE_URL=
TABS_AI_MODEL=
TABS_AI_API_KEY=
# Some relays lose parts of streamed answers (the start of an answer missing): false asks for whole answers instead.
# TABS_AI_STREAM=false
# For example DeepSeek:
#   TABS_AI_BASE_URL=https://api.deepseek.com
#   TABS_AI_MODEL=deepseek-chat
# or Ollama on this machine:
#   TABS_AI_BASE_URL=http://127.0.0.1:11434/v1
#   TABS_AI_MODEL=qwen3

# Optional transcribing (stem separation, audio to MIDI); see server/separator/requirements.txt. No models are bundled.
# TABS_PYTHON=E:/Code/.venv/Scripts/python.exe
# TABS_SEPARATOR_MODELS=E:/Models/separator
# TABS_TRANSCRIBER_MODELS=E:/Models/transcriber

# Your own sample sets (the bundled one in resources/soundfonts/ is always listed).
# TABS_SOUNDFONTS=E:/Music/soundfonts

# The demo tabs put into a new library on its first start.
# TABS_DEMO_SONGS=E:/Music/demo-tabs
